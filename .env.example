# Zyra Mesh Environment Configuration
PROJECT_NAME="Zyra Mesh - Intelligent Multi-Agent Marketplace & Distillation Engine"
API_V1_STR="/api/v1"

# Database Connection (SQLite by default, PostgreSQL supported)
DATABASE_URL="sqlite:///./zyra_mesh.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zyramesh"

# AI Backend Providers ("mock", "ollama", "gemini", "nvidia")
DEFAULT_LLM_PROVIDER="mock"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_DEFAULT_MODEL="qwen2.5:1.5b-instruct"

# Google Gemini API (Free tier at https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_DEFAULT_MODEL="gemini-1.5-flash"

# NVIDIA NIM API (Free credits at https://build.nvidia.com/)
NVIDIA_API_KEY=""
NVIDIA_DEFAULT_MODEL="meta/llama-3.1-70b-instruct"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# Speechmatics Speech-to-Text API
SPEECHMATICS_API_KEY=""

# Testmail Automated Audit & Notifications API
TESTMAIL_API_KEY=""
TESTMAIL_NAMESPACE="u5api"

# Security & Secret Settings
SECRET_KEY="zyra-secure-mesh-vault-prod-2026-calibrated-token"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Engine Parameters
DEFAULT_TRUST_MEAN=0.5
DEFAULT_TRUST_UNCERTAINTY=0.5
UNCERTAINTY_VERIFICATION_THRESHOLD=0.40
FAILURE_PROPAGATION_THRESHOLD=0.60
