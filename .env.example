# Zyra Mesh Environment Configuration
PROJECT_NAME="Zyra Mesh - Intelligent Multi-Agent Marketplace"
API_V1_STR="/api/v1"

# Database Connection (SQLite by default, PostgreSQL supported)
DATABASE_URL="sqlite:///./zyra_mesh.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zyramesh"

# AI Backend Providers ("mock", "ollama", "gemini")
DEFAULT_LLM_PROVIDER="mock"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_DEFAULT_MODEL="qwen2.5:1.5b-instruct"
GEMINI_API_KEY=""
GEMINI_DEFAULT_MODEL="gemini-1.5-flash"

# Engine Parameters
DEFAULT_TRUST_MEAN=0.5
DEFAULT_TRUST_UNCERTAINTY=0.5
UNCERTAINTY_VERIFICATION_THRESHOLD=0.40
